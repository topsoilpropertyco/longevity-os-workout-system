# ── Longevity OS — Mac mini worker ───────────────────────────────────────────
# Copy to `.env` in this directory. Never commit `.env`.
# Every value here is used for an OUTBOUND connection only. The mini opens no
# ports, runs no tunnel, and accepts nothing inbound.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# SERVICE ROLE key, not the anon key: the worker claims and completes jobs on
# Seth's behalf and must bypass RLS. This key is a full-database credential —
# it lives only on the mini and in Vercel's env, never in the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# ── LM Studio ────────────────────────────────────────────────────────────────
# The OpenAI-compatible server. Localhost on purpose: LM Studio is never
# exposed to the network. Start it with "Server" → "Start" in the LM Studio UI.
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Model ids. "local-model" routes to whatever LM Studio currently has loaded,
# which is usually what you want.
# ⚠️ Verify at build time: `curl http://localhost:1234/v1/models` and confirm
# the vision model actually accepts images — a text-only model returns prose
# where the whiteboard parser expects strict JSON.
LMSTUDIO_MODEL=local-model
LMSTUDIO_VISION_MODEL=local-model

# ── Worker behaviour ─────────────────────────────────────────────────────────
# Identifies this worker in llm_jobs.claimed_by. Defaults to the hostname.
WORKER_ID=

# Poll interval in milliseconds. 15000 is the documented default (PRD §13).
WORKER_POLL_MS=15000

# Realtime instead of polling. Optional, off by default: polling is simpler,
# survives a dropped websocket, and 15s is fast enough for an async queue.
WORKER_USE_REALTIME=false

# Job kinds this worker will claim. Comma-separated; empty means all.
# why_line, chat, vision_parse, weekly_narrative, session_summary
WORKER_JOB_KINDS=

# Keep-alive: the free Supabase project pauses after ~7 days of inactivity.
# The worker touches a row on this interval as insurance. 6 hours.
WORKER_KEEPALIVE_MS=21600000

# Table the keep-alive touches. Must exist and be writable by the service role.
WORKER_KEEPALIVE_TABLE=worker_heartbeat

# debug | info | warn | error
LOG_LEVEL=info
