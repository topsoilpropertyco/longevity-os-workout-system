# Longevity OS — environment template
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit a real value.
# "Local dev: required" means the dev server will not do anything useful without it.
# Every other key degrades gracefully — the app still renders today's card without them.
# Full walkthrough, in order, with minutes per step: docs/SETUP.md

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL. Supabase dashboard → Project Settings → API → Project URL.
# Local dev: required.
SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co

# Anon/publishable key. Same page, "anon public". Safe in the browser; RLS protects the data.
# Local dev: required.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER_ANON_KEY.0000000000000000000000000000000000000000

# Service-role key. Same page, "service_role". Bypasses RLS — server only, never in the browser,
# never in a NEXT_PUBLIC_ var. Used by cron routes, webhooks and the worker.
# Local dev: required only for the sync/webhook routes.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER_SERVICE_ROLE_KEY.0000000000000000000000000000000000000000

# Browser-visible copies of the two public values above. Same strings, different names,
# because Next.js only exposes NEXT_PUBLIC_-prefixed vars to client components.
# Local dev: required.
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER_ANON_KEY.0000000000000000000000000000000000000000

# Your athlete uuid — the `id` of your row in `public.users`, which is the same value
# as your `auth.users` id. Sign in once at /sign-in, then read it off:
#   select id, email from public.users;
# The browser never needs this (it gets the id from the session). The jobs that run with
# NOBODY signed in do: the nightly cron's plan snapshot and the Oura sync both write rows
# on your behalf and cannot ask a session who you are.
# Local dev: optional — required for /api/cron/* and /api/oura/sync.
LONGEVITY_USER_ID=00000000-0000-0000-0000-000000000000

# ── Oura ────────────────────────────────────────────────────────────────────
# ⚠️ OURA RETIRED PERSONAL ACCESS TOKENS IN DECEMBER 2025. New ones cannot be created,
# so Oura is now OAuth2 (authorization code + PKCE). See docs/SETUP.md step 8.
#
# The fast path sets all four of these for you: `npx tsx scripts/oura-auth.ts`.
# It asks for the two values below, writes this file, and connects the ring.

# OAuth application credentials: https://cloud.ouraring.com/oauth/applications
# Local dev: optional — without them the app falls back to the three sliders.
OURA_CLIENT_ID=OURAPP7QK2XZ
OURA_CLIENT_SECRET=4a7f2c91be6d05387fa1c4e9b2d76038cf15ae9427b0d6c318fa25e791b4cd60

# Where Oura sends the browser back. Must match the redirect URI on the Oura application
# page EXACTLY — a trailing slash difference is enough to be rejected.
# Local dev: required if OURA_CLIENT_ID is set.
OURA_REDIRECT_URI=http://localhost:3000/api/oura/callback

# AES-256-GCM key for the token set at rest, 64 hex characters (32 bytes). Tokens are
# NEVER written unencrypted — a missing key is a hard error, not a plaintext fallback.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Local dev: required if OURA_CLIENT_ID is set.
OURA_TOKEN_KEY=9f3c1d7a5e08b426fd91c30a7b6e2854af17d9c0b385e6427fa0c19d8b35e7f2

# LEGACY ONLY. A personal access token issued before December 2025 still works, and this
# is honoured for it. ⚠️ A NEW ONE CANNOT BE ISSUED — Oura removed the page. If you do not
# already have one, leave this unset and use the OAuth keys above.
# Local dev: optional, and only meaningful for a grandfathered token.
OURA_PAT=

# ── Strava ──────────────────────────────────────────────────────────────────
# Developer app credentials: strava.com/settings/api → your application.
# Local dev: optional — without them, cardio is manual entry.
STRAVA_CLIENT_ID=174213
STRAVA_CLIENT_SECRET=3f9c1a7e5b2d84660c1fa93be7d5028a4c6e1b7f

# OAuth callback. Must match the Authorization Callback Domain on the Strava app page.
# Use the localhost form in dev and the deployed origin in production.
# Local dev: required if STRAVA_CLIENT_ID is set.
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# Any string you invent. Strava echoes it back in the GET challenge when you create the
# webhook subscription; the callback route rejects the handshake if it does not match.
# Local dev: only needed when creating the webhook subscription (production).
STRAVA_WEBHOOK_VERIFY_TOKEN=longevity-os-strava-verify-6bd42f19

# ── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather (/newbot, then copy the token).
# Local dev: optional — the bot is not needed to use the app.
TELEGRAM_BOT_TOKEN=8102447351:AAF3nQxKd7pRmYt2vLbZs9WcJhE4uXgQiO0

# Secret header for setWebhook. Any string you invent; the /api/telegram route rejects
# requests whose X-Telegram-Bot-Api-Secret-Token header does not match.
# Local dev: only needed when the webhook is registered (production).
TELEGRAM_WEBHOOK_SECRET=longevity-os-tg-hook-a41c7e90d3b2

# Seth's chat ID — where the daily brief, summaries and check-ins go. Numeric.
# Local dev: optional; required for any outbound message.
TELEGRAM_CHAT_ID=574839201

# ── LLM ─────────────────────────────────────────────────────────────────────
# Gemini free-tier API key, used only when the Mac mini has not claimed a job in 60 s.
# Get it from Google AI Studio. ⚠️ Free-tier RPM/RPD limits change — verify on build day (RESEARCH §8).
# Local dev: optional — without it, "why" copy falls back to deterministic templates.
GEMINI_API_KEY=AIzaSyB4T7xQmKp2Rv9LdNc1Hs6WfYgE8UoJz3A

# LM Studio's OpenAI-compatible server on the Mac mini. This is the value the WORKER uses,
# on the mini itself, over loopback. Vercel never calls this — the mini has no inbound ports.
# Local dev: required only when running worker/.
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# ── App ─────────────────────────────────────────────────────────────────────
# Absolute origin of this deployment. Used to build webhook URLs, OAuth redirects and
# absolute links in Telegram messages. No trailing slash.
# Local dev: required.
APP_URL=http://localhost:3000

# Shared secret for the nightly cron routes. Any string you invent; the route rejects
# requests without a matching Authorization: Bearer header, so the endpoints are not
# publicly triggerable.
# Local dev: optional — only needed to call /api/cron/* by hand.
CRON_SECRET=longevity-os-cron-9e17ab53c8d0f462
