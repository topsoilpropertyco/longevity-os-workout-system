# dependencies
node_modules/
.pnp
.pnp.js

# builds — including artifacts a stray `tsc` leaves beside the sources, which
# would otherwise shadow the TypeScript under Vite's resolver and run old code
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map
packages/*/fixtures/**/*.js
packages/*/test/**/*.js
dist/
.next/
out/
build/
*.tsbuildinfo

# env — never commit secrets
.env
.env.local
.env*.local
!.env.example

# data: large downloaded corpora are regenerated by scripts/ingest-exercises.ts
data/raw/*.json
data/raw/.fetch.log
data/media/

# personal source material — Seth drops files here, they stay local
docs/programs/kot/raw/*
!docs/programs/kot/raw/README.md
!docs/programs/kot/raw/.gitkeep
docs/imports/raw/*
!docs/imports/raw/README.md
!docs/imports/raw/.gitkeep

# tooling
.vercel
.supabase/
coverage/
.DS_Store
*.log
.claude/plans/*.local.md
