{
  "name": "@longevity/integrations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure TypeScript integration clients (Oura, Strava, Telegram, LLM) for Longevity OS. No framework imports, no runtime I/O beyond built-in fetch.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./oura": "./src/oura/index.ts",
    "./strava": "./src/strava/index.ts",
    "./telegram": "./src/telegram/index.ts",
    "./llm": "./src/llm/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@longevity/engine": "*",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=20"
  }
}
